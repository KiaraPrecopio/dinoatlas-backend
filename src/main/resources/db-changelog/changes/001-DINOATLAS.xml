                        'NEKTOBENTHIC',
                        'NEKTONIC',
                        'PLANKTONIC',
                        'FOSSORIAL',
                        'SEMIFOSSORIAL',
                        'GROUND_DWELLING',
                        'CURSORIAL',
                        'SALTATORIAL',
                        'SCANSORIAL',
                        'ARBOREAL',
                        'GLIDING',
                        'VOLANT',
                        'AMPHIBIOUS',
