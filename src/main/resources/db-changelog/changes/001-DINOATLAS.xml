    </changeSet>

    <changeSet id="001-DINOATLAS-011" author="precopio.kiara">
        <comment>
            Add enum constraints for diet column in taxon table.
        </comment>
        <modifyDataType tableName="taxon" columnName="diet"
                        newDataType="ENUM(
                        'CHEMOAUTOTROPH',
